# InvariantQL local integration smoke configuration
#
# Setup from the repository root:
#   uv sync --extra duckdb --extra postgres --extra mongodb --extra azure
#   cp scripts/integration/.env.example scripts/integration/.env
#   chmod 600 scripts/integration/.env          # Linux/macOS/WSL
#   uv run python scripts/integration/smoke.py
#
# Run only selected targets while editing the file:
#   uv run python scripts/integration/smoke.py postgres
#   uv run python scripts/integration/smoke.py mongodb adls-json --rows 2
#
# This .env.example contains no credentials. The real adjacent .env is ignored
# by git and excluded from package artifacts. Process environment values take
# precedence over values loaded from the file.

# Keep smoke reads deliberately small. Every generated query also has LIMIT.
INVARIANTQL_SMOKE_ROWS=5
INVARIANTQL_SMOKE_BATCH_SIZE=1024

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# REQUIRED: libpq DSN and an existing table/view. The adapter quotes schema and
# table identifiers exactly, so preserve their case. Use a read-only DB role.
#
# Local disposable PostgreSQL example:
# INVARIANTQL_POSTGRES_DSN=host=127.0.0.1 port=5432 dbname=mydb user=readonly password=CHANGE_ME sslmode=disable
#
# Remote example: use certificate and hostname verification. sslrootcert is a
# local CA file path understood by libpq.
# INVARIANTQL_POSTGRES_DSN=host=db.example.com port=5432 dbname=mydb user=readonly password=CHANGE_ME sslmode=verify-full sslrootcert=/absolute/path/to/root-ca.pem
INVARIANTQL_POSTGRES_DSN=
INVARIANTQL_POSTGRES_SCHEMA=public
INVARIANTQL_POSTGRES_TABLE=
INVARIANTQL_POSTGRES_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# REQUIRED: URI, database, and an existing NONEMPTY collection. Without a
# declared schema, InvariantQL samples documents; an empty collection cannot be
# inferred. Use a read-only MongoDB role. Keep the timeout in the URI so a bad
# endpoint fails promptly. mongodb+srv enables TLS by default; for mongodb://
# remote endpoints explicitly enable TLS and certificate validation.
#
# Example only:
# INVARIANTQL_MONGODB_URI=mongodb://readonly:CHANGE_ME@127.0.0.1:27017/?authSource=admin&serverSelectionTimeoutMS=10000
# Remote URI options commonly include tls=true, tlsCAFile=/absolute/path/ca.pem,
# tlsAllowInvalidCertificates=false, serverSelectionTimeoutMS=10000, and
# appName=invariantql-smoke.
INVARIANTQL_MONGODB_URI=
INVARIANTQL_MONGODB_DATABASE=
INVARIANTQL_MONGODB_COLLECTION=
INVARIANTQL_MONGODB_SAMPLE_SIZE=100

# ---------------------------------------------------------------------------
# ADLS Gen2 JSON
# ---------------------------------------------------------------------------
# REQUIRED: account, container, and ONE EXACT object path. The container is
# already configured separately: do not repeat it in INVARIANTQL_ADLS_PATH.
# If root=landing and path=events/example.ndjson, the object is read from
# <container>/landing/events/example.ndjson. Do not repeat the root in path.
AZURE_STORAGE_ACCOUNT_NAME=
INVARIANTQL_ADLS_CONTAINER=
INVARIANTQL_ADLS_ROOT=
INVARIANTQL_ADLS_PATH=path/to/example.ndjson
INVARIANTQL_ADLS_ENDPOINT_SUFFIX=core.windows.net

# true = newline-delimited JSON / NDJSON, one object per line.
# false = one top-level JSON array.
INVARIANTQL_JSON_LINES=true
# Optional: gzip, zstd, bz2, or xz. Leave blank for automatic/plain input.
INVARIANTQL_JSON_COMPRESSION=

# Choose EXACTLY ONE Azure authentication group below. Do not populate several.
# If all are blank/false, adlfs falls back to DefaultAzureCredential/provider
# auth (for example Azure CLI login or managed identity).

# Option A: storage account key
AZURE_STORAGE_ACCOUNT_KEY=

# Option B: SAS token (with or without a leading '?')
AZURE_STORAGE_SAS_TOKEN=

# Option C: full storage connection string
AZURE_STORAGE_CONNECTION_STRING=

# Option D: service-principal triple (all three are required together)
AZURE_STORAGE_CLIENT_ID=
AZURE_STORAGE_CLIENT_SECRET=
AZURE_STORAGE_TENANT_ID=

# Option E: anonymous/public container access
AZURE_STORAGE_ANON=false
